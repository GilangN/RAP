local updateQueued = false
local function updateUIList()
    if updateQueued then return end
    updateQueued = true

    task.spawn(function()
        task.wait(0.15)
        updateQueued = false

        local children = scrollList:GetChildren()
        for i = 1, #children do
            local child = children[i]
            if child:IsA("Frame") then child:Destroy() end
        end

        local eggChildren = FOLDER_PATH:GetChildren()

        table.sort(eggChildren, function(a, b)
            local weightA = rarityWeights[getEggRarity(a.Name)] or 0
            local weightB = rarityWeights[getEggRarity(b.Name)] or 0
            if weightA ~= weightB then return weightA > weightB end
            
            local luckA, luckB = getEggLuck(a.Name), getEggLuck(b.Name)
            if luckA ~= luckB then return luckA > luckB end
            
            local sizeA, sizeB = getEggWeight(a), getEggWeight(b)
            if sizeA ~= sizeB then return sizeA > sizeB end
            
            return a.Name < b.Name
        end)

        for i = 1, #eggChildren do
            local item = eggChildren[i]
            local eggName = item.Name
            local eggRarity = getEggRarity(eggName)

            if rarityToggles[eggRarity] then
                local rowFrame = Instance.new("Frame", scrollList)
                rowFrame.Size = UDim2.new(1, -6, 0, 26)
                rowFrame.BackgroundTransparency = 1

                local infoLabel = Instance.new("TextLabel", rowFrame)
                infoLabel.Size = UDim2.new(1, -72, 1, 0)
                infoLabel.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
                infoLabel.BackgroundTransparency = 0.25
                infoLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                infoLabel.TextSize = 11
                infoLabel.Font = Enum.Font.SourceSansBold
                infoLabel.Text = " " .. eggName .. " [" .. eggRarity .. "]"
                infoLabel.TextXAlignment = Enum.TextXAlignment.Left
                Instance.new("UICorner", infoLabel).CornerRadius = UDim.new(0, 4)

                local tpButton = Instance.new("TextButton", rowFrame)
                tpButton.Size = UDim2.new(0, 30, 1, 0)
                tpButton.Position = UDim2.new(1, -68, 0, 0)
                tpButton.BackgroundColor3 = Color3.fromRGB(60, 60, 180)
                tpButton.BackgroundTransparency = 0.2
                tpButton.TextColor3 = Color3.fromRGB(255, 255, 255)
                tpButton.TextSize = 11
                tpButton.Font = Enum.Font.SourceSansBold
                tpButton.Text = "TP"
                Instance.new("UICorner", tpButton).CornerRadius = UDim.new(0, 4)

                tpButton.MouseButton1Click:Connect(function()
                    if item and item.Parent then
                        local part = getEggPart(item)
                        if part and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                            LocalPlayer.Character.HumanoidRootPart.CFrame = part.CFrame + Vector3.new(0, 10, 0)
                        end
                    end
                end)

                local autoButton = Instance.new("TextButton", rowFrame)
                autoButton.Size = UDim2.new(0, 34, 1, 0)
                autoButton.Position = UDim2.new(1, -34, 0, 0)
                autoButton.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
                autoButton.BackgroundTransparency = 0.2
                autoButton.TextColor3 = Color3.fromRGB(255, 255, 255)
                autoButton.TextSize = 10
                autoButton.Font = Enum.Font.SourceSansBold
                autoButton.Text = "Auto"
                Instance.new("UICorner", autoButton).CornerRadius = UDim.new(0, 4)

                autoButton.MouseButton1Click:Connect(function()
                    task.spawn(function() processEggCollection(item) end)
                end)
            end
        end
    end)
end

updateEggFilterUI = function()
    local children = eggFilterScroll:GetChildren()
    for i = 1, #children do
        local child = children[i]
        if child:IsA("Frame") then child:Destroy() end
    end

    local filteredEggs = {}
    for eggName, rarity in pairs(eggRarityDatabase) do
        if rarityToggles[rarity] then
            table.insert(filteredEggs, eggName)
        end
    end

    table.sort(filteredEggs, function(a, b)
        return getEggLuck(a) > getEggLuck(b)
    end)

    for i = 1, #filteredEggs do
        local eggName = filteredEggs[i]
        if eggAutoToggles[eggName] == nil then
            eggAutoToggles[eggName] = true
        end
        local isStateOn = eggAutoToggles[eggName]

        local eggRow = Instance.new("Frame", eggFilterScroll)
        eggRow.Size = UDim2.new(1, 0, 0, 24)
        eggRow.BackgroundTransparency = 1

        local eggBtn = Instance.new("TextButton", eggRow)
        eggBtn.Size = UDim2.new(1, 0, 1, 0)
        eggBtn.BackgroundColor3 = isStateOn and Color3.fromRGB(0, 170, 255) or Color3.fromRGB(120, 0, 0)
        eggBtn.BackgroundTransparency = 0.2
        eggBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        eggBtn.TextSize = 11
        eggBtn.Font = Enum.Font.SourceSansBold
        eggBtn.Text = eggName .. ":" .. (isStateOn and "ON" or "OFF")
        Instance.new("UICorner", eggBtn).CornerRadius = UDim.new(0, 4)

        eggBtn.MouseButton1Click:Connect(function()
            eggAutoToggles[eggName] = not eggAutoToggles[eggName]
            local state = eggAutoToggles[eggName]
            eggBtn.BackgroundColor3 = state and Color3.fromRGB(0, 170, 255) or Color3.fromRGB(120, 0, 0)
            eggBtn.Text = eggName .. ":" .. (state and "ON" or "OFF")
            saveSettings()
        end)
    end
end

