            end)
            task.wait(5) -- Jeda diubah menjadi 5 detik
        else
            task.wait(0.5) -- Berhenti atau menunggu sampai di-on-kan kembali
        end
    end
end)

task.spawn(function()
    while true do
        if autoFarmEnabled then
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local farmedAny = false
                local children = FOLDER_PATH:GetChildren()
                for i = 1, #children do
                    local item = children[i]
                    if not autoFarmEnabled then break end
                    local eggName = item.Name
                    local eggRarity = getEggRarity(eggName)
                    
                    if rarityToggles[eggRarity] and (eggAutoToggles[eggName] ~= false) and getEggPart(item) then
                        farmedAny = true
                        processEggCollection(item)
                        task.wait(1)
                        break
                    end
                end
                if not farmedAny then task.wait(1) end
            else
                task.wait(1)
            end
        else
            task.wait(0.5)
        end
    end
end)

