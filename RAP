local function setupESP(eggItem)
    local targetPart = getEggPart(eggItem)
    if not targetPart then return end

    local eggName = eggItem.Name
    local eggRarity = getEggRarity(eggName)
    local uniqueColor = getEggColor(eggName)

    if not globalEspEnabled or not rarityToggles[eggRarity] then
        removeESP(eggItem)
        return
    end

    removeESP(eggItem)

    local highlight = Instance.new("Highlight")
    highlight.Name = "EggESP_Highlight"
    highlight.Adornee = eggItem
    highlight.FillColor = uniqueColor
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 1 
    highlight.Parent = eggItem

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "EggESP_Gui"
    billboard.Size = UDim2.new(0, 120, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Adornee = targetPart
    billboard.Parent = eggItem

    local textLabel = Instance.new("TextLabel")
    textLabel.Name = "ESPText"
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.TextColor3 = uniqueColor
    textLabel.TextStrokeTransparency = 0
    textLabel.TextSize = 13
    textLabel.Font = Enum.Font.SourceSansBold
    textLabel.Parent = billboard

    task.spawn(function()
        while billboard and billboard.Parent and targetPart and targetPart.Parent and globalEspEnabled and rarityToggles[eggRarity] do
            local character = LocalPlayer.Character
            if character and character:FindFirstChild("HumanoidRootPart") then
                local distance = (character.HumanoidRootPart.Position - targetPart.Position).Magnitude
                textLabel.Text = string.format("%s\n< %d m >", eggName, math.floor(distance))
            else
                textLabel.Text = string.format("%s\n[Jarak: ?]", eggName)
            end
            task.wait(0.3)
        end
    end)
end

local function refreshAllESP()
    for _, item in ipairs(FOLDER_PATH:GetChildren()) do
        setupESP(item)
    end
end

local function triggerPrompts(target)
    if target:IsA("ProximityPrompt") then
        fireproximityprompt(target)
    end
    for _, desc in ipairs(target:GetDescendants()) do
        if desc:IsA("ProximityPrompt") then
            fireproximityprompt(desc)
        end
    end
end

-- Fungsi proses pengambilan egg (TP Base menggunakan sumbu Y 40312 lalu -300 tanpa efek gravitasi)
local function processEggCollection(item)
    if not item or not item.Parent then return end
    local part = getEggPart(item)
    local character = LocalPlayer.Character
    if not part or not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local hrp = character.HumanoidRootPart
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    -- 1. TP ke atas egg (Offset 4)
    hrp.CFrame = part.CFrame + Vector3.new(0, 4, 0)
    
    -- 2. Fly Mode (Melayang agar tidak jatuh)
    local flying = true
    local flyConn
    flyConn = RunService.RenderStepped:Connect(function()
        if not flying or not hrp or not hrp.Parent then
            if flyConn then flyConn:Disconnect() end
            return
        end
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        if humanoid then
            humanoid:ChangeState(Enum.HumanoidStateType.Physics)
        end
    end)
    
    -- 3. Jeda 1 detik sebelum pickup
    task.wait(1)
    
    -- 4. Pickup sampai egg hilang dari folder
    local targetItem = item
    while targetItem and targetItem.Parent == FOLDER_PATH do
        triggerPrompts(targetItem)
        task.wait(0.3)
    end
    
    -- 5. Jeda 1 detik setelah terangkat
    task.wait(1)
    
    -- 6. Matikan mode fly dan TP ke base (Sumbu Y diset ke 40312 lalu dikurangi 300)
    flying = false
    if flyConn then flyConn:Disconnect() end
    if humanoid then
        humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
    
    local currentPos = hrp.Position
    hrp.CFrame = CFrame.new(currentPos.X, 40312 - 300, currentPos.Z)
    
    -- Jeda tambahan sebelum lanjut ke egg berikutnya
    task.wait(1)
end

local function updateUIList()
    for _, child in ipairs(scrollList:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end

    local children = FOLDER_PATH:GetChildren()

    -- Pengurutan Prioritas: Rarity > Luck > Weight
    table.sort(children, function(a, b)
        local rarityA = getEggRarity(a.Name)
        local rarityB = getEggRarity(b.Name)
        local weightRarityA = rarityWeights[rarityA] or 0
        local weightRarityB = rarityWeights[rarityB] or 0
        
        if weightRarityA ~= weightRarityB then
            return weightRarityA > weightRarityB
        else
            local luckA = getEggLuck(a.Name)
            local luckB = getEggLuck(b.Name)
            if luckA ~= luckB then
                return luckA > luckB
            else
                local sizeA = getEggWeight(a)
                local sizeB = getEggWeight(b)
                if sizeA ~= sizeB then
                    return sizeA > sizeB
                else
                    return a.Name < b.Name
                end
            end
        end
    end)

    for _, item in ipairs(children) do
        local eggName = item.Name
        local eggRarity = getEggRarity(eggName)
        local passRarityFilter = (rarityToggles[eggRarity] == true)

        if passRarityFilter then
            local rowFrame = Instance.new("Frame")
            rowFrame.Size = UDim2.new(1, -6, 0, 26)
            rowFrame.BackgroundTransparency = 1
            rowFrame.Parent = scrollList

            local infoLabel = Instance.new("TextLabel")
            infoLabel.Size = UDim2.new(1, -72, 1, 0)
            infoLabel.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
            infoLabel.BackgroundTransparency = 0.25
            infoLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            infoLabel.TextSize = 11
            infoLabel.Font = Enum.Font.SourceSansBold
            infoLabel.Text = " " .. eggName .. " [" .. eggRarity .. "]"
            infoLabel.TextXAlignment = Enum.TextXAlignment.Left
            infoLabel.Parent = rowFrame

            local infoCorner = Instance.new("UICorner")
            infoCorner.CornerRadius = UDim.new(0, 4)
            infoCorner.Parent = infoLabel

            local tpButton = Instance.new("TextButton")
            tpButton.Size = UDim2.new(0, 30, 1, 0)
            tpButton.Position = UDim2.new(1, -68, 0, 0)
            tpButton.BackgroundColor3 = Color3.fromRGB(60, 60, 180)
            tpButton.BackgroundTransparency = 0.2
            tpButton.TextColor3 = Color3.fromRGB(255, 255, 255)
            tpButton.TextSize = 11
            tpButton.Font = Enum.Font.SourceSansBold
            tpButton.Text = "TP"
            tpButton.Parent = rowFrame

            local tpCorner = Instance.new("UICorner")
            tpCorner.CornerRadius = UDim.new(0, 4)
            tpCorner.Parent = tpButton

            tpButton.MouseButton1Click:Connect(function()
                if item and item.Parent then
                    local part = getEggPart(item)
                    if part and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        LocalPlayer.Character.HumanoidRootPart.CFrame = part.CFrame + Vector3.new(0, 4, 0)
                    end
                end
            end)

            local autoButton = Instance.new("TextButton")
            autoButton.Size = UDim2.new(0, 34, 1, 0)
            autoButton.Position = UDim2.new(1, -34, 0, 0)
            autoButton.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
            autoButton.BackgroundTransparency = 0.2
            autoButton.TextColor3 = Color3.fromRGB(255, 255, 255)
            autoButton.TextSize = 10
            autoButton.Font = Enum.Font.SourceSansBold
            autoButton.Text = "Auto"
            autoButton.Parent = rowFrame

            local autoCorner = Instance.new("UICorner")
            autoCorner.CornerRadius = UDim.new(0, 4)
            autoCorner.Parent = autoButton

            autoButton.MouseButton1Click:Connect(function()
                task.spawn(function()
                    processEggCollection(item)
                end)
            end)
        end
    end
end

task.spawn(function()
    while true do
        if autoFarmEnabled then
            local character = LocalPlayer.Character
            local hrp = character and character:FindFirstChild("HumanoidRootPart")
            
            if hrp then
                local farmedAny = false
                local children = FOLDER_PATH:GetChildren()
                
                table.sort(children, function(a, b)
                    local rarityA = getEggRarity(a.Name)
                    local rarityB = getEggRarity(b.Name)
                    local weightRarityA = rarityWeights[rarityA] or 0
                    local weightRarityB = rarityWeights[rarityB] or 0
                    
                    if weightRarityA ~= weightRarityB then
                        return weightRarityA > weightRarityB
                    else
                        local luckA = getEggLuck(a.Name)
                        local luckB = getEggLuck(b.Name)
                        if luckA ~= luckB then
                            return luckA > luckB
                        else
                            local sizeA = getEggWeight(a)
                            local sizeB = getEggWeight(b)
                            if sizeA ~= sizeB then
                                return sizeA > sizeB
                            else
                                return a.Name < b.Name
                            end
                        end
                    end
                end)
                
                for _, item in ipairs(children) do
                    if not autoFarmEnabled then break end
                    local eggName = item.Name
                    local eggRarity = getEggRarity(eggName)
                    
                    if rarityToggles[eggRarity] then
                        local part = getEggPart(item)
                        if part then
                            farmedAny = true
                            processEggCollection(item)
                            task.wait(1)
                            break
                        end
                    end
                end
                
                if not farmedAny then
                    task.wait(1)
                end
            else
                task.wait(1)
            end
        else
            task.wait(0.5)
        end
    end
end)

local rarityListOrder = {"Ethereal", "Divine", "Mythic", "Legendary", "Epic", "Rare", "Common"}
local rarityYPos = 0

for _, rarityName in ipairs(rarityListOrder) do
    local isToggled = rarityToggles[rarityName]
    local rBtn = Instance.new("TextButton")
    rBtn.Size = UDim2.new(1, -6, 0, 24)
    rBtn.Position = UDim2.new(0, 0, 0, rarityYPos)
