local function getEggRarity(eggName)
    return eggRarityDatabase[eggName] or "Common"
end

local function getEggLuck(eggName)
    return eggLuckDatabase[eggName] or 0
end

local eggColors = {}

local function getEggColor(eggName)
    if not eggColors[eggName] then
        local hash = 0
        for i = 1, #eggName do
            hash = string.byte(eggName, i) + (hash * 31)
        end
        local r = (hash % 155) + 100
        local g = ((hash // 7) % 155) + 100
        local b = ((hash // 13) % 155) + 100
        eggColors[eggName] = Color3.fromRGB(r, g, b)
    end
    return eggColors[eggName]
end

local function getEggPart(eggItem)
    if eggItem:IsA("BasePart") then
        return eggItem
    elseif eggItem:IsA("Model") then
        return eggItem.PrimaryPart or eggItem:FindFirstChildWhichIsA("BasePart")
    end
    return nil
end

local function getEggWeight(eggItem)
    local weightAttr = eggItem:GetAttribute("Weight") or eggItem:GetAttribute("KG") or eggItem:GetAttribute("Mass")
    if type(weightAttr) == "number" then
        return weightAttr
    end

    for _, desc in ipairs(eggItem:GetDescendants()) do
        if (desc.Name == "Weight" or desc.Name == "KG" or desc.Name == "Mass") then
            if desc:IsA("NumberValue") or desc:IsA("IntValue") then
                return desc.Value
            elseif desc:IsA("StringValue") then
                local num = tonumber(string.match(desc.Value, "%d+%.?%d*"))
                if num then return num end
            end
        end
    end

    if eggItem:IsA("Model") then
        local ok, size = pcall(function()
            return eggItem:GetExtentsSize()
        end)
        if ok and size then
            return size.Magnitude
        end
    end
    
    local part = getEggPart(eggItem)
    if part then
        return part.Size.Magnitude
    end
    
    return 0
end

local function instantPrompt(item)
    if item:IsA("ProximityPrompt") then
        item.HoldDuration = 0
    end
    for _, desc in ipairs(item:GetDescendants()) do
        if desc:IsA("ProximityPrompt") then
            desc.HoldDuration = 0
        end
    end
end

for _, descendant in ipairs(Workspace:GetDescendants()) do
