local function setupESP(eggItem)
    local targetPart = getEggPart(eggItem)
    if not targetPart then return end

    local eggName = eggItem.Name
    local eggRarity = getEggRarity(eggName)
    local uniqueColor = getEggColor(eggName)

    if not globalEspEnabled or not rarityToggles[eggRarity] then
        removeESP(eggItem)
        return
    end

    removeESP(eggItem)

    local highlight = Instance.new("Highlight", eggItem)
    highlight.Name = "EggESP_Highlight"
    highlight.Adornee = eggItem
    highlight.FillColor = uniqueColor
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 1

    local billboard = Instance.new("BillboardGui", eggItem)
    billboard.Name = "EggESP_Gui"
    billboard.Size = UDim2.new(0, 120, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.Adornee = targetPart

    local textLabel = Instance.new("TextLabel", billboard)
    textLabel.Name = "ESPText"
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.TextColor3 = uniqueColor
    textLabel.TextStrokeTransparency = 0
    textLabel.TextSize = 13
    textLabel.Font = Enum.Font.SourceSansBold

    task.spawn(function()
        while billboard and billboard.Parent and targetPart and targetPart.Parent and globalEspEnabled and rarityToggles[eggRarity] do
            local character = LocalPlayer.Character
            if character and character:FindFirstChild("HumanoidRootPart") then
                local distance = (character.HumanoidRootPart.Position - targetPart.Position).Magnitude
                textLabel.Text = string.format("%s\n< %d m >", eggName, math.floor(distance))
            else
                textLabel.Text = string.format("%s\n[Jarak: ?]", eggName)
            end
            task.wait(0.3)
        end
    end)
end

local function refreshAllESP()
    for _, item in ipairs(FOLDER_PATH:GetChildren()) do
        setupESP(item)
    end
end

local function triggerPrompts(target)
    if target:IsA("ProximityPrompt") then fireproximityprompt(target) end
    local descendants = target:GetDescendants()
    for i = 1, #descendants do
        local desc = descendants[i]
        if desc:IsA("ProximityPrompt") then fireproximityprompt(desc) end
    end
end

local function processEggCollection(item)
    if not item or not item.Parent then return end
    local part = getEggPart(item)
    local character = LocalPlayer.Character
    if not part or not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local hrp = character.HumanoidRootPart
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    hrp.CFrame = part.CFrame + Vector3.new(0, 10, 0)
    
    local flying = true
    local flyConn = RunService.RenderStepped:Connect(function()
        if not flying or not hrp or not hrp.Parent then return end
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        if humanoid then humanoid:ChangeState(Enum.HumanoidStateType.Physics) end
    end)
    
    task.wait(0.5)
    while item and item.Parent == FOLDER_PATH do
        triggerPrompts(item)
        task.wait(0.3)
    end
    task.wait(0.5)
    
    flying = false
    if flyConn then flyConn:Disconnect() end
    if humanoid then humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end
    
