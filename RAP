local function removeESP(eggItem)
    if eggItem:FindFirstChild("EggESP_Gui") then eggItem.EggESP_Gui:Destroy() end
    if eggItem:FindFirstChild("EggESP_Highlight") then eggItem.EggESP_Highlight:Destroy() end
end

local function clearAllESP()
    for _, item in ipairs(FOLDER_PATH:GetChildren()) do
        local part = getEggPart(item)
        if part then removeESP(part) end
        if item:IsA("Model") then removeESP(item) end
    end
end

