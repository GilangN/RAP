local function setupQueueOnTeleport()
    if autoHopEnabled and queue_on_teleport then
        pcall(function()
            queue_on_teleport([[
                task.wait(3)
                loadstring(game:HttpGet("https://raw.githubusercontent.com/GilangN/RAP/refs/heads/main/RAP"))()
            ]])
        end)
